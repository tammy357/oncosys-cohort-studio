{
 "about": "Join-inflation suite: requests where a join can count samples more than once (several slides per sample, clinical or survival records joined by patient barcode, slides after a matched-normal condition) plus controls that must NOT be flagged. Written from a scan of the frozen release, not from the parser or the AI. Each case has the gold steps an analyst would write (joins in 'rows' mode, as in the brief's demo). 'expect' records what the engine must show: which step inflates, rows before the fix and the sample count after the fix (frozen by evals/run_inflation.py --freeze). Run: python evals/run_inflation.py [--parser rules ai].",
 "cases": [
  {
   "id": "inf_dx_demo",
   "kind": "slides",
   "request": "primary tumors with both RNA and protein data and a diagnostic slide",
   "gold_steps": [
    {
     "op": "sample_type",
     "values": [
      "Primary Tumor"
     ]
    },
    {
     "op": "layer",
     "layer": "rna"
    },
    {
     "op": "layer",
     "layer": "protein"
    },
    {
     "op": "join",
     "table": "slides",
     "key": "sample_id",
     "mode": "rows",
     "slide_kinds": [
      "diagnostic (FFPE)"
     ]
    }
   ],
   "why": "The brief's live demo.",
   "expect": {
    "inflated_steps": [
     {
      "step": 4,
      "op": "join",
      "rows": 776,
      "samples": 731
     }
    ],
    "samples_after_fix": 731
   }
  },
  {
   "id": "inf_frozen_top",
   "kind": "slides",
   "request": "primary tumours that have a frozen top-section slide",
   "gold_steps": [
    {
     "op": "sample_type",
     "values": [
      "Primary Tumor"
     ]
    },
    {
     "op": "join",
     "table": "slides",
     "key": "sample_id",
     "mode": "rows",
     "slide_kinds": [
      "frozen, top section"
     ]
    }
   ],
   "why": "Frozen top sections are the most duplicated slide kind (up to 6 per sample).",
   "expect": {
    "inflated_steps": [
     {
      "step": 2,
      "op": "join",
      "rows": 1045,
      "samples": 1044
     }
    ],
    "samples_after_fix": 1044
   }
  },
  {
   "id": "inf_frozen_bottom_rna",
   "kind": "slides",
   "request": "tumor samples with RNA-seq and a frozen bottom-section slide",
   "gold_steps": [
    {
     "op": "sample_type",
     "values": [
      "Primary Tumor"
     ]
    },
    {
     "op": "layer",
     "layer": "rna"
    },
    {
     "op": "join",
     "table": "slides",
     "key": "sample_id",
     "mode": "rows",
     "slide_kinds": [
      "frozen, bottom section"
     ]
    }
   ],
   "why": "Bottom sections: fewer samples, still several slides for some.",
   "expect": {
    "inflated_steps": [
     {
      "step": 3,
      "op": "join",
      "rows": 472,
      "samples": 427
     }
    ],
    "samples_after_fix": 427
   }
  },
  {
   "id": "inf_any_slide",
   "kind": "slides",
   "request": "every primary tumour with at least one whole-slide image of any kind",
   "gold_steps": [
    {
     "op": "sample_type",
     "values": [
      "Primary Tumor"
     ]
    },
    {
     "op": "join",
     "table": "slides",
     "key": "sample_id",
     "mode": "rows",
     "slide_kinds": []
    }
   ],
   "why": "Any slide kind: most samples have both a frozen and a diagnostic slide, so rows roughly double.",
   "expect": {
    "inflated_steps": [
     {
      "step": 2,
      "op": "join",
      "rows": 2704,
      "samples": 1098
     }
    ],
    "samples_after_fix": 1098
   }
  },
  {
   "id": "inf_luma_dx_protein",
   "kind": "slides",
   "request": "luminal A tumours with RPPA data and an FFPE diagnostic slide",
   "gold_steps": [
    {
     "op": "sample_type",
     "values": [
      "Primary Tumor"
     ]
    },
    {
     "op": "layer",
     "layer": "protein"
    },
    {
     "op": "join",
     "table": "clinical",
     "key": "sample_id",
     "mode": "rows"
    },
    {
     "op": "filter",
     "table": "clinical",
     "field": "pam50",
     "cmp": "in",
     "value": [
      "LumA"
     ]
    },
    {
     "op": "join",
     "table": "slides",
     "key": "sample_id",
     "mode": "rows",
     "slide_kinds": [
      "diagnostic (FFPE)"
     ]
    }
   ],
   "why": "Inflation after a clinical filter: the double count hides behind a subtype.",
   "expect": {
    "inflated_steps": [
     {
      "step": 5,
      "op": "join",
      "rows": 339,
      "samples": 324
     }
    ],
    "samples_after_fix": 324
   }
  },
