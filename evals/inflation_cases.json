  {
   "id": "inf_clin_by_patient_er_neg",
   "kind": "clinical-by-patient",
   "request": "ER-negative tumours, with clinical data matched on the patient barcode",
   "gold_steps": [
    {
     "op": "sample_type",
     "values": [
      "Primary Tumor"
     ]
    },
    {
     "op": "join",
     "table": "clinical",
     "key": "patient_id",
     "mode": "rows"
    },
    {
     "op": "filter",
     "table": "clinical",
     "field": "er_status",
     "cmp": "in",
     "value": [
      "Negative"
     ]
    }
   ],
   "why": "Patients with a normal sample have two clinical rows, so their tumour matches twice.",
