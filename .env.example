# Hosted model (your own key)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Model calls allowed per server run (protects your key)
# COHORT_STUDIO_AI_CALL_LIMIT=200

# Local model (Ollama, no key)
# COHORT_STUDIO_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# COHORT_STUDIO_MODEL=qwen2.5:7b
